# Copy to .env and fill in. Never commit .env.

# Gemini API key from https://aistudio.google.com/apikey
# Server-only: do not prefix with NEXT_PUBLIC_, or it ships to the browser.
GEMINI_API_KEY=

# Gemini model names. Check the current names in Gemini's docs.
GEMINI_MODEL=
# Image model for aged portraits (stretch goal).
GEMINI_IMAGE_MODEL=

# Where the AR app is served; the QR code links here with the council data in the URL hash.
# Local: the AR Vite dev server. Demo: the deployed HTTPS address.
NEXT_PUBLIC_AR_URL=https://localhost:5173
