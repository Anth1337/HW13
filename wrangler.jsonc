{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The deployed URL is https://<name>.<your workers.dev subdomain>.workers.dev
  "name": "hw13-pets",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Room WebSockets go to the worker; everything else is a static file from dist/.
    "run_worker_first": ["/party/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // The free plan needs SQLite-backed Durable Objects.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true }
}
